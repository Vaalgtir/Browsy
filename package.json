{
  "name": "browsy",
  "version": "0.0.1",
  "private": true,
  "description": "Navigateur perso façon Arc, sur Electron",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "install-electron",
    "dev:arc": "env -u ELECTRON_RUN_AS_NODE BROWSY_ARC_EXTENSIONS=1 electron-vite dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
